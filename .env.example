# URL do backend NestJS. Usada apenas pelo servidor do painel (proxy em /api/backend).
# Em produção (VERCEL_ENV=production) é obrigatória e precisa ser https; sem ela o proxy
# responde CONFIG_MISSING. Em dev/preview, vazia = http://localhost:8000.
# API_URL=https://krypto.duckdns.org
API_URL=http://localhost:8000

# Opcional: alternativa de build time (inlined) para API_URL; API_URL tem prioridade.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: mesmo valor de CONTROL_API_KEY do backend. Enviado como header X-Control-Api-Key
# somente pelo servidor do painel; nunca chega ao navegador.
# API_KEY=

# Opcional: liga o login do painel. Sem isso, o painel fica aberto para quem acessar a URL
# (que pode pausar as operações e acionar o kill switch). Recomendado fora da sua máquina.
# DASHBOARD_PASSWORD=

# Opcional: segredo que assina o cookie de sessão. Se vazio, deriva da senha
# (trocar a senha desloga todo mundo).
# SESSION_SECRET=

# Opcional: subcaminho onde o painel é servido (ex.: /bot para jacksonmagnabosco.dev/bot).
# Vazio = raiz do domínio. Entra no build: mudou, precisa rebuildar.
# NEXT_PUBLIC_BASE_PATH=/bot

# Opcional: true atrás de proxy confiável (Vercel) para limitar tentativas de login por IP.
# TRUST_PROXY=true
