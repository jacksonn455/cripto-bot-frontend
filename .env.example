# Variáveis de servidor do painel. Nunca coloque valores reais de segredos aqui:
# copie para .env.local (ignorado pelo git) ou configure na Vercel.
#
# NEXT_PUBLIC_API_URL não deve ser usada: variáveis NEXT_PUBLIC_* vão para o bundle do
# navegador e o painel só fala com o backend pelo servidor (/api/backend). Use API_URL.

# URL do backend, sem barra no final. Obrigatória e https em produção (senão o proxy responde
# CONFIG_MISSING). O valor abaixo é para desenvolvimento local.
# Produção: API_URL=https://krypto-bot.duckdns.org
API_URL=http://localhost:8000

# Mesmo valor de CONTROL_API_KEY do backend; enviado só pelo servidor, nunca chega ao navegador.
# API_KEY=

# Liga o login do painel. Sem ela, quem tiver a URL pode pausar e acionar o kill switch.
# DASHBOARD_PASSWORD=

# Segredo que assina o cookie de sessão. Vazio = derivado da senha.
# SESSION_SECRET=

# true atrás de proxy confiável (Vercel) para limitar tentativas de login por IP.
# TRUST_PROXY=true

# Subcaminho onde o painel é servido (ex.: /bot). Vazio = raiz. Mudou, precisa rebuildar.
# NEXT_PUBLIC_BASE_PATH=/bot
